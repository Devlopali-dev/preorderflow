# --- Postgres ---
POSTGRES_USER=preorderflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=preorderflow
DATABASE_URL=postgresql://preorderflow:change-me@postgres:5432/preorderflow?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Limites de débit ---
# Actives par défaut : 100 requêtes/min/IP, et des seuils stricts sur login, lien magique, recensement,
# commande publique et réglages. `true` les coupe (suite E2E, développement) : JAMAIS en production.
RATE_LIMIT_DISABLED=false
# Derrière un reverse proxy (Traefik) : nombre de proxys devant l'API (1 en général), pour lire
# l'IP réelle du visiteur dans X-Forwarded-For. Sans cela, tous les visiteurs partagent la même limite.
# Laisser vide en accès direct (l'en-tête est alors ignoré, donc non falsifiable).
TRUST_PROXY=

# --- API (NestJS) ---
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-super-secret
JWT_EXPIRES_IN=1d
MAGIC_LINK_SECRET=change-me-too
MAGIC_LINK_EXPIRES_IN=15m
SESSION_COOKIE_SECRET=change-me-cookie-secret

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Utilisé côté API pour construire l'URL du magic link envoyé par email.
WEB_URL=http://localhost:3000

# --- Emails (cf. docs/architecture.md §5.8) ---
# NOTIFICATION_EMAIL_PROVIDER=resend|smtp — vide ou valeur inconnue = fallback
# console (aucune dépendance obligatoire, cf. CLAUDE.md §32).
NOTIFICATION_EMAIL_PROVIDER=resend
EMAIL_FROM="PreOrderFlow <no-reply@example.com>"

# Resend (si NOTIFICATION_EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# SMTP (si NOTIFICATION_EMAIL_PROVIDER=smtp) — n'importe quel serveur SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# --- Alertes push admin (ntfy.sh ou instance self-hostée) ---
# Préfixe PREORDERFLOW_ volontaire pour ne pas entrer en collision avec un
# NTFY_URL/NTFY_TOPIC/NTFY_AUTH déjà utilisé ailleurs sur la machine.
# Laisser PREORDERFLOW_NTFY_TOPIC vide désactive cette fonctionnalité.
PREORDERFLOW_NTFY_URL=https://ntfy.sh
PREORDERFLOW_NTFY_TOPIC=
PREORDERFLOW_NTFY_AUTH=

# --- Paiement manuel (MVP) : lien Revolut.me ---
# Le montant est ajouté automatiquement, en centimes, dans `amount` (300 pour 3 €).
# Un lien de paiement propre à une campagne, s'il existe, a priorité sur celui-ci.
REVOLUT_PAYMENT_LINK=https://revolut.me/tonpseudo?currency=EUR&amount=

# --- Paiement carte (optionnel, choisi par l'admin par commande — jamais
# obligatoire au cœur de l'app, cf. CLAUDE.md §32) ---
# Webhook à configurer côté Stripe sur : /api/v1/webhooks/stripe
# (événement checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Anti-spam recensement ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Serveur MCP (apps/mcp-server) : compte admin/opérateur dédié, lecture
# seule uniquement (cf. docs/mcp-server.md) ---
PREORDERFLOW_API_URL=http://localhost:3001
PREORDERFLOW_MCP_EMAIL=
PREORDERFLOW_MCP_PASSWORD=

# --- Divers ---
NODE_ENV=development
TZ=UTC
