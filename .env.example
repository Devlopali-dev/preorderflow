# --- Postgres ---
POSTGRES_USER=preorderflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=preorderflow
DATABASE_URL=postgresql://preorderflow:change-me@postgres:5432/preorderflow?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- API (NestJS) ---
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-super-secret
JWT_EXPIRES_IN=1d
MAGIC_LINK_SECRET=change-me-too
MAGIC_LINK_EXPIRES_IN=15m
SESSION_COOKIE_SECRET=change-me-cookie-secret

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Utilisé côté API pour construire l'URL du magic link envoyé par email.
WEB_URL=http://localhost:3000

# --- Emails (Resend par défaut, cf. docs/architecture.md §5.8) ---
NOTIFICATION_EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="PreOrderFlow <no-reply@example.com>"

# --- Alertes push admin (ntfy.sh ou instance self-hostée) ---
# Préfixe PREORDERFLOW_ volontaire pour ne pas entrer en collision avec un
# NTFY_URL/NTFY_TOPIC/NTFY_AUTH déjà utilisé ailleurs sur la machine.
# Laisser PREORDERFLOW_NTFY_TOPIC vide désactive cette fonctionnalité.
PREORDERFLOW_NTFY_URL=https://ntfy.sh
PREORDERFLOW_NTFY_TOPIC=
PREORDERFLOW_NTFY_AUTH=

# --- Paiement manuel (MVP) : lien Revolut.me, montant ajouté automatiquement ---
REVOLUT_PAYMENT_LINK=https://revolut.me/tonpseudo

# --- Paiement carte (préparé, non obligatoire au MVP) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Anti-spam recensement ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Serveur MCP (apps/mcp-server) : compte admin/opérateur dédié, lecture
# seule uniquement (cf. docs/mcp-server.md) ---
PREORDERFLOW_API_URL=http://localhost:3001
PREORDERFLOW_MCP_EMAIL=
PREORDERFLOW_MCP_PASSWORD=

# --- Divers ---
NODE_ENV=development
TZ=UTC
