// PreOrderFlow — Prisma schema (Phase 1)
// PostgreSQL, UUID, UTC. Aucun champ de stock stocké : le stock est dérivé de InventoryMovement.

generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev hors Docker (macOS) ; le binaire musl explicite
  // pour les conteneurs Docker (Alpine récent = OpenSSL 3, pas 1.1 — sans
  // ce target Prisma se trompe de moteur et le conteneur crash au démarrage).
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (admin)
// ---------------------------------------------------------------------------

enum AdminRole {
  ADMIN
  OPERATOR
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         AdminRole @default(OPERATOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs AuditLog[]

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Campaign
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  RECENSEMENT
  COMMANDES_OUVERTES
  COMMANDES_FERMEES
  PRODUCTION
  EXPEDITION
  TERMINEE
  ANNULEE
}

model Campaign {
  id                String         @id @default(uuid())
  name              String
  slug              String         @unique
  description       String?
  status            CampaignStatus @default(DRAFT)
  startDate         DateTime?
  endDate           DateTime?
  productId         String
  product           Product        @relation(fields: [productId], references: [id])
  imageUrl          String?
  documentUrl       String?
  // Lien de paiement propre à la campagne (ex : revolut.me/…) ; à défaut, celui du .env.
  paymentLink       String?
  // Rempli quand le mail « les commandes sont ouvertes » a été envoyé aux personnes intéressées :
  // empêche tout doublon si la campagne repasse par cet état.
  ordersOpenedMailedAt DateTime?
  interestSettings  Json?          // ex: quantités max, message légal, seuils d'affichage
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  interests CampaignInterest[]
  media     CampaignMedia[]
  orders    Order[]

  @@map("campaigns")
}

// Médias d'une campagne (photos + PDF) affichés en galerie sur la page
// publique. Jusqu'à 5 aperçus (limite d'écriture côté backend). Une entité
// séparée plutôt qu'un champ JSON pour garder un ordre stable et prévoir
// plus tard légendes/variantes.
enum CampaignMediaType {
  IMAGE
  DOCUMENT
}

model CampaignMedia {
  id           String            @id @default(uuid())
  campaignId   String
  campaign     Campaign          @relation(fields: [campaignId], references: [id])
  url          String
  type         CampaignMediaType @default(IMAGE)
  // Aperçu de la 1ère page généré à l'upload d'un PDF (documents uniquement).
  // Permet d'afficher un vrai visuel dans la galerie au lieu d'une icône.
  thumbnailUrl String?
  position     Int               @default(0)
  createdAt    DateTime          @default(now())

  @@index([campaignId, position])
  @@map("campaign_media")
}

// ---------------------------------------------------------------------------
// Interest (recensement)
// ---------------------------------------------------------------------------

model CampaignInterest {
  id               String   @id @default(uuid())
  campaignId       String
  campaign         Campaign @relation(fields: [campaignId], references: [id])
  customerId       String   // rattachement obligatoire : find-or-create Customer par email
  customer         Customer @relation(fields: [customerId], references: [id])
  email            String
  firstName        String
  lastName         String
  phone            String?
  comment          String?
  consentToContact Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // La quantité demandée est dérivée : somme des items (une ligne par couleur).
  items CampaignInterestItem[]

  @@index([campaignId])
  @@index([email])
  @@map("campaign_interests")
}

model CampaignInterestItem {
  id         String           @id @default(uuid())
  interestId String
  interest   CampaignInterest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant   @relation(fields: [variantId], references: [id])
  quantity   Int

  @@unique([interestId, variantId])
  @@index([variantId])
  @@map("campaign_interest_items")
}

// ---------------------------------------------------------------------------
// Product
// ---------------------------------------------------------------------------

model Product {
  id             String   @id @default(uuid())
  sku            String   @unique
  name           String
  slug           String   @unique
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  currency       String   @default("EUR")
  taxRate        Decimal  @db.Decimal(5, 2) @default(0)
  weight         Decimal? @db.Decimal(10, 3) // kg
  active         Boolean  @default(true)
  manufacturable Boolean  @default(true)
  documentUrl    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaigns Campaign[]
  variants  ProductVariant[]
  photos    ProductPhoto[]

  @@map("products")
}

// Photos d'un produit, 3 au maximum (limite d'écriture côté backend, comme les
// aperçus d'une campagne). `position` ordonne la galerie : la première est la
// photo principale.
model ProductPhoto {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, position])
  @@map("product_photos")
}

// Palette globale de couleurs, gérée depuis /settings et réutilisable par
// tous les produits. `hex` est une donnée d'affichage (pastille), pas du CSS.
model Color {
  id        String   @id @default(uuid())
  name      String   @unique
  hex       String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]

  @@map("colors")
}

// Unité vendable et stockable d'un produit. Stock, production, lignes de
// commande et intérêts référencent la variante, jamais le produit directement.
// Invariant : tout produit a au moins une variante ; un produit sans couleur
// a une variante par défaut (colorId = null), créée avec le produit.
model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  colorId   String?
  color     Color?   @relation(fields: [colorId], references: [id])
  sku       String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems       OrderItem[]
  productionItems  ProductionItem[]
  inventoryMoves   InventoryMovement[]
  interestItems    CampaignInterestItem[]

  @@unique([productId, colorId])
  @@index([productId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Customer / Address
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String
  lastName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses Address[]
  orders    Order[]
  interests CampaignInterest[]

  @@map("customers")
}

enum AddressType {
  BILLING
  SHIPPING
}

model Address {
  id         String      @id @default(uuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  type       AddressType
  firstName  String
  lastName   String
  company    String?
  address1   String
  address2   String?
  postalCode String
  city       String
  country    String
  phone      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([customerId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Order / OrderItem
// ---------------------------------------------------------------------------

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum OrderFulfillmentStatus {
  UNFULFILLED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
}

// Mode de remise : livraison à l'adresse du client ou remise en main propre
// (sans adresse ni frais de livraison).
enum DeliveryMethod {
  SHIPPING
  PICKUP
}

model Order {
  id                 String                  @id @default(uuid())
  number             String                  @unique // ex: 2026-0042
  customerId         String
  customer           Customer                @relation(fields: [customerId], references: [id])
  // Campagne d'origine, facultative : la commande reste indépendante du recensement.
  campaignId         String?
  campaign           Campaign?               @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  status             OrderStatus             @default(DRAFT)
  paymentStatus      OrderPaymentStatus      @default(UNPAID)
  fulfillmentStatus  OrderFulfillmentStatus  @default(UNFULFILLED)
  deliveryMethod     DeliveryMethod          @default(SHIPPING)
  currency           String                  @default("EUR")
  subtotal           Decimal                 @db.Decimal(10, 2)
  shippingAmount     Decimal                 @db.Decimal(10, 2) @default(0)
  taxAmount          Decimal                 @db.Decimal(10, 2) @default(0)
  total              Decimal                 @db.Decimal(10, 2)
  billingAddress     Json                    // snapshot figé au moment de la commande
  shippingAddress    Json                    // snapshot figé au moment de la commande
  notes              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  items     OrderItem[]
  payments  Payment[]
  shipment  Shipment?

  @@index([customerId])
  @@index([campaignId])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  taxRate   Decimal  @db.Decimal(5, 2) @default(0)
  total     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Payment
// ---------------------------------------------------------------------------

enum PaymentProvider {
  MANUAL
  BANK_TRANSFER
  CASH
  STRIPE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                 String          @id @default(uuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id])
  provider           PaymentProvider
  providerReference  String?
  amount             Decimal         @db.Decimal(10, 2)
  currency           String          @default("EUR")
  status             PaymentStatus   @default(PENDING)
  paidAt             DateTime?
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([orderId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Production
// ---------------------------------------------------------------------------

enum ProductionBatchStatus {
  PLANNED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  CANCELLED
}

model ProductionBatch {
  id        String                 @id @default(uuid())
  reference String                 @unique // ex: 2026-001
  status    ProductionBatchStatus  @default(PLANNED)
  startedAt DateTime?
  completedAt DateTime?
  notes     String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  items ProductionItem[]

  @@map("production_batches")
}

model ProductionItem {
  id                String           @id @default(uuid())
  productionBatchId String
  productionBatch   ProductionBatch  @relation(fields: [productionBatchId], references: [id])
  variantId         String
  variant           ProductVariant   @relation(fields: [variantId], references: [id])
  quantityPlanned   Int
  quantityProduced  Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([productionBatchId])
  @@index([variantId])
  @@map("production_items")
}

// ---------------------------------------------------------------------------
// Inventory (stock calculé à partir des mouvements)
// ---------------------------------------------------------------------------

enum InventoryMovementType {
  PRODUCTION
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  SALE
  RETURN
  DAMAGE
  TRANSFER
}

enum InventoryReferenceType {
  ORDER
  PRODUCTION_BATCH
  MANUAL
}

model InventoryMovement {
  id            String                  @id @default(uuid())
  variantId     String
  variant       ProductVariant          @relation(fields: [variantId], references: [id])
  quantity      Int                     // signé : positif = entrée, négatif = sortie
  type          InventoryMovementType
  referenceType InventoryReferenceType
  referenceId   String?                 // id polymorphe (Order.id ou ProductionBatch.id), pas de FK
  reason        String?
  createdAt     DateTime                @default(now())

  @@index([variantId])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

// ---------------------------------------------------------------------------
// Shipment
// ---------------------------------------------------------------------------

enum ShipmentStatus {
  PENDING
  LABEL_CREATED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
}

model Shipment {
  id              String         @id @default(uuid())
  orderId         String         @unique // relation 1-1 : une commande = un colis
  order           Order          @relation(fields: [orderId], references: [id])
  carrier         String?
  trackingNumber  String?
  trackingUrl     String?
  status          ShipmentStatus @default(PENDING)
  shippedAt       DateTime?
  deliveredAt     DateTime?
  weight          Decimal?       @db.Decimal(10, 3)
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  events ShipmentEvent[]

  @@map("shipments")
}

model ShipmentEvent {
  id         String         @id @default(uuid())
  shipmentId String
  shipment   Shipment       @relation(fields: [shipmentId], references: [id])
  status     ShipmentStatus
  message    String?
  occurredAt DateTime       @default(now())
  metadata   Json?

  @@index([shipmentId])
  @@map("shipment_events")
}

// ---------------------------------------------------------------------------
// Notification
// ---------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  SMS
  WEBHOOK
}

enum NotificationTemplate {
  INTEREST_REGISTERED
  ORDERS_OPENED
  ORDER_CREATED
  PAYMENT_RECEIVED
  ORDER_READY
  ORDER_SHIPPED
  ORDER_DELIVERED
  ADMIN_ALERT
  CUSTOMER_MAGIC_LINK
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id          String                @id @default(uuid())
  channel     NotificationChannel
  template    NotificationTemplate
  recipient   String                // email/phone/url selon le canal
  payload     Json?
  status      NotificationStatus    @default(PENDING)
  sentAt      DateTime?
  error       String?
  createdAt   DateTime              @default(now())

  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

enum AuditAction {
  ORDER_CREATED
  ORDER_CANCELLED
  PAYMENT_CONFIRMED
  PRODUCTION_STARTED
  PRODUCTION_COMPLETED
  INVENTORY_ADJUSTED
  SHIPMENT_CREATED
  SHIPMENT_UPDATED
  CUSTOMER_UPDATED
  CUSTOMER_DATA_EXPORTED
  CUSTOMER_ANONYMIZED
  SETTINGS_UPDATED
  CAMPAIGN_DELETED
  CAMPAIGN_REACTIVATED
}

// Config email/ntfy éditable depuis /settings — une seule ligne (id fixe),
// prime sur .env qui reste le bootstrap par défaut si rien n'est configuré
// ici. Les secrets (clé API, mot de passe SMTP, auth ntfy) sont en clair
// comme ils l'étaient déjà dans .env — aucune infra de chiffrement dans le
// projet, protégés par le RBAC ADMIN sur l'écriture et jamais renvoyés en
// lecture (cf. SettingsController).
model AppSettings {
  id              String   @id @default("singleton")
  businessName    String?
  contactEmail    String?
  emailProvider   String?
  resendApiKey    String?
  smtpHost        String?
  smtpPort        Int?
  smtpSecure      Boolean  @default(false)
  smtpUser        String?
  smtpPassword    String?
  emailFrom       String?
  ntfyUrl         String?
  ntfyTopic       String?
  ntfyAuth        String?
  // Frais de livraison : forfait appliqué à chaque commande, offert au-delà
  // d'un sous-total HT seuil (null = jamais offert).
  shippingFlatRate       Decimal  @default(0) @db.Decimal(10, 2)
  freeShippingThreshold  Decimal? @db.Decimal(10, 2)
  updatedAt       DateTime @updatedAt

  @@map("app_settings")
}

// Surcharge éditable d'un template de notification (§17) — une ligne par
// valeur de NotificationTemplate qui a été personnalisée ; l'absence de
// ligne = le template par défaut codé en dur (cf. notification-templates.ts)
// s'applique. Substitution simple {{placeholder}} au moment de l'envoi.
model NotificationTemplateOverride {
  template  NotificationTemplate @id
  subject   String
  html      String
  updatedAt DateTime             @updatedAt

  @@map("notification_template_overrides")
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String
  user       AdminUser   @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}
